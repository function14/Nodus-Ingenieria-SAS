DATABASE_URL="postgresql://nodus:nodus@localhost:5442/nodus?schema=public"
AUTH_SECRET="genera-uno: openssl rand -base64 32"
AUTH_TRUST_HOST=true
CRON_SECRET="opcional: protege /api/cron/sla (Vercel Cron lo envia como Bearer)"
# Comunicaciones gobernadas (F1): canal email via Resend. Sin RESEND_API_KEY
# el canal degrada a in-app sin romper el flujo.
RESEND_API_KEY="opcional: re_xxxx"
# Remitente. Sin dominio verificado en Resend, el sandbox onboarding@resend.dev
# SOLO entrega al correo dueno de la cuenta; a cualquier otra direccion falla.
EMAIL_FROM="onboarding@resend.dev"
# Redirige TODO el correo saliente a un unico buzon. Pensado para demos y
# entornos que no son produccion: el destinatario que habria recibido queda
# igualmente registrado y auditado. Vacio en produccion.
EMAIL_REDIRECT_TO=""
EMAIL_FROM="onboarding@resend.dev"
# Repositorio documental (F3): almacenamiento S3-compatible tras una sola
# interfaz. Desarrollo local = MinIO (docker compose). Produccion = Cloudflare
# R2 (decision del cliente; API S3-compatible). Si existe R2_ACCOUNT_ID, el
# adaptador usa R2 y las credenciales del API token; si no, MinIO local.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9002"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="nodus"
MINIO_SECRET_KEY="nodus-local-secret"
MINIO_BUCKET="nodus-docs"
# Produccion (Cloudflare R2) — descomentar cuando haya cuenta R2:
# R2_ACCOUNT_ID="<account-id>"
# R2_ACCESS_KEY_ID="<access-key-id>"
# R2_SECRET_ACCESS_KEY="<secret-access-key>"
# R2_BUCKET="nodus-docs"
# R2_REGION="auto"
